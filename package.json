{
  "name": "echocrime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx server/index.ts\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "test:logic": "tsx scripts/test-hypothesis.ts",
    "dev:web": "vite",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "wavesurfer.js": "^8.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.31",
